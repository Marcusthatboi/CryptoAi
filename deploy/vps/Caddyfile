{
  email {$LETSENCRYPT_EMAIL}
}

{$APP_DOMAIN} {
  encode zstd gzip
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "SAMEORIGIN"
    Referrer-Policy "strict-origin-when-cross-origin"
  }

  @service_worker path /sw.js
  header @service_worker Cache-Control "no-store, no-cache, must-revalidate, max-age=0, s-maxage=0"
  header @service_worker Pragma "no-cache"
  header @service_worker Expires "0"
  header @service_worker Surrogate-Control "no-store"
  header @service_worker CDN-Cache-Control "no-store"
  header @service_worker Cloudflare-CDN-Cache-Control "no-store"

  reverse_proxy frontend:8080
}

{$API_DOMAIN} {
  encode zstd gzip

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "no-referrer"
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
  }

  @cors_allowed header Origin https://dacryptobeast.com https://www.dacryptobeast.com
  @cors_preflight {
    method OPTIONS
    header Origin *
    header Access-Control-Request-Method *
  }

  handle @cors_preflight {
    header @cors_allowed Access-Control-Allow-Origin "{http.request.header.Origin}"
    header @cors_allowed Access-Control-Allow-Credentials "true"
    header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
    header Access-Control-Allow-Headers "Accept, Authorization, Content-Type, Origin, Stripe-Signature, X-Requested-With, X-CSRF-Token"
    header Access-Control-Max-Age "600"
    header Vary "Origin, Access-Control-Request-Method, Access-Control-Request-Headers"
    respond "" 204
  }

  handle_errors {
    @cors_allowed_error header Origin https://dacryptobeast.com https://www.dacryptobeast.com
    header @cors_allowed_error Access-Control-Allow-Origin "{http.request.header.Origin}"
    header @cors_allowed_error Access-Control-Allow-Credentials "true"
    header @cors_allowed_error Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
    header @cors_allowed_error Access-Control-Allow-Headers "Accept, Authorization, Content-Type, Origin, Stripe-Signature, X-Requested-With, X-CSRF-Token"
    header @cors_allowed_error Vary "Origin, Access-Control-Request-Method, Access-Control-Request-Headers"
    respond "{\"detail\":\"Upstream unavailable\"}" {http.error.status_code}
  }

  reverse_proxy backend:8002
}
