# Robinhood API Configuration
# Get these from https://robinhood.com/us/en/account/settings/api

ROBINHOOD_CLIENT_ID=your_client_id_here
ROBINHOOD_CLIENT_SECRET=your_client_secret_here
ROBINHOOD_REDIRECT_URI=http://localhost:8000/auth/robinhood/callback

# Binance API Configuration
# Get these from https://www.binance.com/en/user/settings/api-management

BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here
BINANCE_TESTNET=false  # Set to true for testing (recommended first)
BINANCE_TLD=com  # Use 'us' for Binance.US accounts in restricted regions

# Optional: Ollama Configuration
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=mistral

# Core application configuration
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
MONGODB_URL=mongodb://localhost:27017
DB_NAME=cryptoai
APP_ENV=production
ENVIRONMENT=production
FRONTEND_BASE_URL=https://dacryptobeast.com
FRONTEND_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
ENABLE_API_DOCS=false

# Admin bootstrap identity (used by init_admin.py and admin username fallback)
ADMIN_USERNAME=dacryptobeast_admin
ADMIN_EMAIL=admin@dacryptobeast.com
ADMIN_PASSWORD=replace-with-strong-admin-password
ALLOW_LEGACY_ADMIN_USERNAME=false

# Stripe billing
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_PUBLISHABLE_KEY=pk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Support email delivery
SUPPORT_EMAIL_TO=cryptosupport74@gmail.com
SUPPORT_SMTP_HOST=smtp.gmail.com
SUPPORT_SMTP_PORT=587
SUPPORT_SMTP_USE_TLS=true
SUPPORT_SMTP_USERNAME=your_gmail_address_here
SUPPORT_SMTP_PASSWORD=your_gmail_app_password_here
SUPPORT_EMAIL_FROM=your_gmail_address_here

# Collaboration platform integrations
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
GOOGLE_CHAT_WEBHOOK_URL=

# MongoDB scaling knobs
MONGO_MAX_POOL_SIZE=200
MONGO_MIN_POOL_SIZE=20
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_CONNECT_TIMEOUT_MS=5000

# Realtime controls
MAX_WS_CONNECTIONS=1000
